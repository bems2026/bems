{
  "name": "ibems-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "iBEMS web dashboard — live data via the Node-RED bridge, Supabase-backed history, and audited device control (hardware dispatch gated)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "build:flow": "node node-red-bridge/build-flow.mjs",
    "mock": "node mock-bridge/server.mjs",
    "mock:stop": "node mock-bridge/stop.mjs",
    "verify:pi": "node node-red-bridge/verify.mjs",
    "deploy:pi": "node node-red-bridge/deploy.mjs",
    "rotate-light-token:pi": "node node-red-bridge/rotate-light-api-token.mjs",
    "capture-flow:pi": "node node-red-bridge/capture-live-flow.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bridge": "node --test \"test/**/*.test.mjs\"",
    "test:server": "node --test \"server/**/*.test.mjs\"",
    "ingest": "node server/ingest.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.112.3",
    "@types/three": "^0.185.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
