# iBEMS RM-131: restart Node-RED when a device is reachable but its node has given up.
#
# A tuya node that has given up stays given up, and reads exactly like a device that is unplugged
# (CLAUDE.md: "restart before you suspect hardware"). This checks, every five minutes, whether an
# offline node's device answers on its static address or has announced itself lately, and only
# when that holds on two consecutive checks — and no more than once an hour, never within ten
# minutes of boot — restarts Node-RED. Every decision is in the journal.
#
# Install (as root):
#   cp server/ibems-fleet-recover.service server/ibems-fleet-recover.timer /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now ibems-fleet-recover.timer
#
# Runs as the repo's user (its state file is theirs) and restarts Node-RED through sudo -n, which
# this host allows that user without a password.

[Unit]
Description=iBEMS: restart Node-RED for devices that are reachable but not connected
Wants=network-online.target
After=network-online.target nodered.service

[Service]
Type=oneshot
User=bems
WorkingDirectory=/home/bems/bems
ExecStart=/usr/bin/node server/fleet-recover.mjs
SyslogIdentifier=ibems-fleet-recover
TimeoutStartSec=300
