# Fires server/wifi-prefer.mjs periodically. See ibems-wifi-prefer.service for install steps.
#
# Fifteen minutes is a deliberate compromise: the device AP dropping out costs the whole fleet
# until the Pi returns, so waiting an hour is expensive — but each check rescans the radio, and
# a tighter loop would spend the Pi's airtime on scanning rather than on talking to devices.
#
# Persistent=true so a check that was missed while the Pi was off runs shortly after boot,
# which is exactly when the Pi is most likely to have landed on the wrong network.

[Unit]
Description=Periodically return the Pi to its preferred Wi-Fi network

[Timer]
OnBootSec=3min
OnUnitActiveSec=15min
Persistent=true
Unit=ibems-wifi-prefer.service

[Install]
WantedBy=timers.target
