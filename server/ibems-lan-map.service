# iBEMS RM-131: remember which device announced from which address.
#
# Listens passively on the Tuya discovery ports for 30 s and merges what it hears — with the MAC
# from the neighbour table — into server/data/lan-map.json. `set-device-ip:pi --from-lan-map`
# then addresses every node the map knows with no vendor cloud in the path, and
# `--reservations` prints the table for the access point's DHCP reservations.
#
# Install (as root):
#   cp server/ibems-lan-map.service server/ibems-lan-map.timer /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now ibems-lan-map.timer
#
# Runs as the repo's user so the map file is theirs. Sends nothing; opens no connection.

[Unit]
Description=iBEMS: learn device addresses from their own LAN announcements
Wants=network-online.target
After=network-online.target nodered.service

[Service]
Type=oneshot
User=bems
WorkingDirectory=/home/bems/bems
ExecStart=/usr/bin/node server/lan-map-learn.mjs --seconds=30
SyslogIdentifier=ibems-lan-map
TimeoutStartSec=120
