# server/.env — read by the systemd units as `EnvironmentFile=`, never by the browser bundle.
#
# This file is the checked-in *shape* of that file. It holds no values, and the real
# server/.env is gitignored. Copy it, fill it in on the Pi, and keep the two in step: a key
# that exists only on one Pi is a key the next rebuild loses.
#
# Nothing here may carry a VITE_ prefix except the anon key, which is public by design.
# Anything else with that prefix would be inlined into the frontend bundle by Vite.

# --- Supabase -----------------------------------------------------------------------------
# The service-role key bypasses RLS entirely. It belongs only here, read by server/ingest.mjs
# and server/proxy.mjs directly.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_ANON_KEY=

# --- Proxy --------------------------------------------------------------------------------
PROXY_PORT=
# Argon2/bcrypt hash, never the password itself. Generated by the break-glass helper.
BREAK_GLASS_PASSWORD_HASH=
# `true` lets commands reach real relays. With it unset every command is validated and
# audit-logged but changes nothing, and each control card shows a "not dispatched" badge.
HARDWARE_DISPATCH_ENABLED=
LIGHT_API_TOKEN=

# --- Tuya cloud ---------------------------------------------------------------------------
# TUYA_ACCESS_SECRET is the most sensitive value in this system — ahead of the service-role
# key, because it reaches hardware directly and no RLS scopes it. Read only by server/ code.
# TUYA_REGION names the data centre the project is bound to; the wrong one fails as
# `sign invalid`, which is indistinguishable from a bad secret.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_REGION=

# --- Node-RED admin -----------------------------------------------------------------------
# Required if the Node-RED instance has `adminAuth` set. Used by the CLI deploy scripts AND by
# the proxy: `GET /api/tuya/devices` reads the live flow to mark which vendor devices are
# already enrolled, and `POST /api/enroll` writes to it.
#
# These were missing here once while present in the repo-root .env, and the failure was
# silent: the claimed-set read is separate from the Tuya call, so the fleet still returned
# and every device merely looked unenrolled. The enrolment wizard then offered all 19
# already-enrolled devices as available. The endpoint now returns `claimed_known: false` and
# the wizard says so, but the fix is to set these.
NODE_RED_ADMIN_USER=
NODE_RED_ADMIN_PASS=
