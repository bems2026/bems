# Leave both unset for local dev against `npm run mock` — the Vite dev server proxies
# /api and /ws to the bridge (see vite.config.ts), so no URL is needed and there is no
# CORS issue to work around.
#
# Set both when pointing at the real Pi on the BEMS LAN (Phase F). The Pi's Node-RED
# needs `httpNodeCors` enabled in settings.js for this case — see
# docs/bridge-contract.md §Deployment.
#
# VITE_BRIDGE_HTTP_URL=http://<pi-local-ip>:1880/api
# VITE_BRIDGE_WS_URL=ws://<pi-local-ip>:1880/ws/live

# --- Weather (Overview cards) ----------------------------------------------
# Open-Meteo needs no API key, so nothing secret goes in the bundle. These only
# move the forecast off its default site (the MMSU CARE office, Batac City) and
# are all optional.
#
# VITE_WEATHER_LAT=18.0553
# VITE_WEATHER_LON=120.5646
# VITE_WEATHER_PLACE=Batac City
